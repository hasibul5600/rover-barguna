# Dependencies
node_modules/
.npm-cache/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
dist/

# TypeScript incremental build cache
*.tsbuildinfo
next-env.d.ts

# Environment files — NEVER commit these, they hold live credentials.
# .env.example is the tracked template and is deliberately not ignored.
# The glob (not a fixed list) so any *.local variant — including scratch files
# made while copying values into a host's dashboard — is ignored by default.
.env
.env*.local

# Vercel
.vercel

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Windows shortcuts (accidentally created inside the project tree)
*.lnk

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
