# Admin panel login — the only account, checked directly against these values.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Signs the admin session cookie. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# MongoDB Atlas. Use the mongodb+srv:// form in production.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/rover-barguna

# Cloudinary — backs the gallery uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Canonical site origin, used for Open Graph tags, sitemap.xml and robots.txt.
# Optional on Vercel — it falls back to the deployment URL automatically.
# Set this to your real domain once you have one, e.g. https://roverbarguna.org
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
